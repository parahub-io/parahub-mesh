#!/bin/sh
# Phone-home heartbeat to Parahub cloud
PARAHUB_API_YGG="http://[<YGG_ADDR_MAIN>]/api/v1/iot/mesh/heartbeat"
PARAHUB_API_PUBLIC="https://parahub.io/api/v1/iot/mesh/heartbeat"
HEARTBEAT_KEY=$(grep '^HEARTBEAT_KEY=' /etc/parahub/secrets 2>/dev/null | cut -d= -f2)

# Read firmware role
ROLE=$(cat /etc/parahub/role 2>/dev/null || echo "unknown")

# Read identity from /etc/parahub/keys
. /etc/parahub/keys 2>/dev/null
MAC="${NODE_MAC:-$(cat /sys/class/net/br-private/address 2>/dev/null)}"
HOSTNAME="$(uci -q get system.@system[0].hostname)"
YGG_ADDR="${YGGDRASIL_ADDRESS:-unknown}"
SSID="${PRIVATE_SSID:-unknown}"
UPTIME="$(cut -d. -f1 /proc/uptime)"

# Get mesh IP (br-private primary address, skip anycast/secondary)
MESH_IP=$(ip -4 addr show br-private 2>/dev/null | grep -o 'inet [0-9.]*' | head -1 | cut -d' ' -f2)
MESH_IP="${MESH_IP:-unknown}"

# Generate WireGuard VPS keypair if missing (OTA from pre-VPS firmware)
if [ "$ROLE" != "bee" ] && [ ! -f /etc/parahub/wg_vps_private.key ] && command -v wg >/dev/null 2>&1; then
    umask 077
    wg genkey > /etc/parahub/wg_vps_private.key
    wg pubkey < /etc/parahub/wg_vps_private.key > /etc/parahub/wg_vps_public.key
    logger -t parahub-heartbeat "Generated VPS WireGuard keypair (OTA migration)"
fi

# Read WireGuard VPS public key (Bumblebee only)
WG_PUBKEY=""
if [ -f /etc/parahub/wg_vps_public.key ]; then
    WG_PUBKEY=$(cat /etc/parahub/wg_vps_public.key 2>/dev/null)
fi

# Detect hardware from board_name
HW=$(cat /tmp/sysinfo/board_name 2>/dev/null)
case "$HW" in
    glinet,gl-axt1800) HW="axt1800" ;;
    glinet,gl-mt3000) HW="mt3000" ;;
    glinet,gl-mt6000) HW="mt6000" ;;
    xiaomi,redmi-router-ax6s) HW="ax6s" ;;
    asus,rt-ax53u) HW="ax53u" ;;
    glinet,gl-ar300m16) HW="ar300m16" ;;
    cudy,ap3000outdoor-v1) HW="ap3000outdoor" ;;
    cudy,wr3000-v1) HW="wr3000" ;;
    tplink,cpe710-v1) HW="cpe710" ;;
    *) HW="${HW:-unknown}" ;;
esac

FW_VERSION=$(cat /etc/parahub/version 2>/dev/null || echo "unknown")

# Detect VPN mode — freshness-based (ph42). A `wg show` handshake line is a
# timestamp, not liveness: it persists forever after the last handshake, and
# the mullvad marker file only means "configured". Report a mode only when the
# active tunnel has a handshake younger than 5 min (same bar as
# parahub-gw-check), so the backend guest-gateway election reacts to a dead
# VPN within one heartbeat instead of waiting for a reboot.
VPN_MODE="none"
VPN_IF="vps_gateway"
[ -f /etc/parahub/mullvad_account ] && VPN_IF="mullvad_local"
LAST_HS=$(wg show "$VPN_IF" latest-handshakes 2>/dev/null | awk '{print $NF}' | sort -rn | head -1)
if [ -n "$LAST_HS" ] && [ "$LAST_HS" -gt 0 ] 2>/dev/null; then
    HS_AGE=$(( $(date +%s) - LAST_HS ))
    if [ "$HS_AGE" -lt 300 ]; then
        if [ "$VPN_IF" = "mullvad_local" ]; then
            VPN_MODE="mullvad"
        else
            VPN_MODE="vps"
        fi
    fi
fi

# Mesh topology for per-island guest-gateway election (ph37): this node's own
# mesh interface MACs + every originator MAC it sees. batctl o is the full
# island view (multi-hop), so the backend can join two nodes into one island
# whenever one's mesh MAC appears in the other's originator set — a node with
# an empty originator set is its own island.
MESH_MACS=""
for IF in $(batctl if 2>/dev/null | cut -d: -f1); do
    IF_MAC=$(cat /sys/class/net/$IF/address 2>/dev/null)
    [ -n "$IF_MAC" ] && MESH_MACS="${MESH_MACS}${MESH_MACS:+,}\"${IF_MAC}\""
done
MESH_ORIGINATORS=$(batctl o 2>/dev/null | awk '
    { mac = ($1 == "*") ? $2 : $1
      if (mac ~ /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/ && !seen[mac]++) printf "%s\"%s\"", (n++ ? "," : ""), mac }')

# Guest DHCP leases (ph40+): MAC↔IP pairs on the guest subnet, so the backend
# can translate bound device MACs into this node's paid_clients IPs. The lease
# file mixes private and guest pools — filter by the guest /24. Only the
# guest-VLAN terminator has guest leases; everyone else sends an empty list.
GUEST_LEASES=""
if [ "$ROLE" != "bee" ] && [ -f /tmp/dhcp.leases ]; then
    GUEST_PREFIX=$(uci -q get network.guest.ipaddr | awk -F. 'NF==4 {print $1"."$2"."$3"."}')
    if [ -n "$GUEST_PREFIX" ]; then
        GUEST_LEASES=$(awk -v p="$GUEST_PREFIX" 'index($3, p) == 1 {
            host = ($4 == "*") ? "" : $4
            gsub(/[^A-Za-z0-9._-]/, "", host)
            printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"host\":\"%s\"}", (n++ ? "," : ""), $2, $3, host }' /tmp/dhcp.leases)
    fi
fi

# Telemetry counters (ph41+): raw byte counters — the backend derives rates
# from consecutive heartbeats (uptime detects reboots/counter resets).
# Uplink = default-route device (a bee's mesh default lands on br-private,
# which is its honest uplink).
WAN_DEV=$(ip route 2>/dev/null | grep '^default' | head -1 | sed -n 's/.* dev \([^ ]*\).*/\1/p')
[ -z "$WAN_DEV" ] && WAN_DEV=bat0
WAN_RX=$(cat "/sys/class/net/${WAN_DEV}/statistics/rx_bytes" 2>/dev/null || echo 0)
WAN_TX=$(cat "/sys/class/net/${WAN_DEV}/statistics/tx_bytes" 2>/dev/null || echo 0)
LOAD_1M=$(cut -d' ' -f1 /proc/loadavg)
LOAD_1M="${LOAD_1M:-0}"
MEM_TOTAL=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
MEM_AVAIL=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
MEM_TOTAL="${MEM_TOTAL:-0}"
MEM_AVAIL="${MEM_AVAIL:-0}"

# WiFi clients + free-AP usage: walk AP (Master) VAPs only — mesh-point
# interfaces list mesh peers in assoclist and must not count as clients.
# Guest VAPs are identified by the fleet-wide shared free ESSID.
WIFI_CLIENTS=0; GUEST_CLIENTS=0; GUEST_RX=0; GUEST_TX=0
for W in $(iwinfo 2>/dev/null | awk '/ESSID/ {print $1}'); do
    iwinfo "$W" info 2>/dev/null | grep -q 'Mode: Master' || continue
    N=$(iwinfo "$W" assoclist 2>/dev/null | grep -c '^[0-9A-Fa-f][0-9A-Fa-f]:')
    ESSID=$(iwinfo "$W" info 2>/dev/null | sed -n 's/.*ESSID: "\(.*\)".*/\1/p')
    if [ "$ESSID" = "parahub.io/free" ]; then
        GUEST_CLIENTS=$((GUEST_CLIENTS + N))
        GUEST_RX=$((GUEST_RX + $(cat "/sys/class/net/${W}/statistics/rx_bytes" 2>/dev/null || echo 0)))
        GUEST_TX=$((GUEST_TX + $(cat "/sys/class/net/${W}/statistics/tx_bytes" 2>/dev/null || echo 0)))
    else
        WIFI_CLIENTS=$((WIFI_CLIENTS + N))
    fi
done

STATS="{\"uplink_dev\":\"${WAN_DEV}\",\"wan_rx\":${WAN_RX},\"wan_tx\":${WAN_TX},\"guest_rx\":${GUEST_RX},\"guest_tx\":${GUEST_TX},\"wifi_clients\":${WIFI_CLIENTS},\"guest_clients\":${GUEST_CLIENTS},\"load_1m\":${LOAD_1M},\"mem_total\":${MEM_TOTAL},\"mem_avail\":${MEM_AVAIL}}"

PAYLOAD="{\"mac\":\"${MAC}\",\"hostname\":\"${HOSTNAME}\",\"yggdrasil_address\":\"${YGG_ADDR}\",\"firmware_version\":\"${FW_VERSION}\",\"hardware_profile\":\"${HW}\",\"uptime\":${UPTIME},\"private_ssid\":\"${SSID}\",\"firmware_role\":\"${ROLE}\",\"mesh_ip\":\"${MESH_IP}\",\"wg_public_key\":\"${WG_PUBKEY}\",\"vpn_mode\":\"${VPN_MODE}\",\"mesh_macs\":[${MESH_MACS}],\"mesh_originators\":[${MESH_ORIGINATORS}],\"guest_leases\":[${GUEST_LEASES}],\"stats\":${STATS}}"

RESPONSE=""

if [ "$ROLE" = "bee" ]; then
    # Bee: ensure internet reachability via batman-adv gateway when no WAN.
    # Note: BusyBox "ip route show default" may return all routes — use grep filter.
    # Re-derive when there is no default at all, OR when our only default is a
    # mesh one (via br-private) whose gateway has gone unreachable (e.g. the
    # serving bumblebee moved to a different MAC-derived IP). Without the reach
    # test a bee keeps a dead mesh default until reboot. The derive below uses
    # `ip route replace`, so a live re-derive swaps atomically and a failed one
    # leaves the existing default untouched — no regression.
    NEED_GW=0
    DEF_LINE=$(ip route 2>/dev/null | grep '^default' | head -1)
    if [ -z "$DEF_LINE" ]; then
        NEED_GW=1
    elif echo "$DEF_LINE" | grep -q 'br-private'; then
        CUR_GW=$(echo "$DEF_LINE" | awk '{print $3}')
        [ -n "$CUR_GW" ] && ! ping -c 1 -W 3 "$CUR_GW" >/dev/null 2>&1 && NEED_GW=1
    fi
    if [ "$NEED_GW" = "1" ]; then
        ANYCAST_GW="10.250.250.1"
        GW_IP=""

        # Try anycast gateway first (set by bumblebees in gw_mode=server)
        ip route replace "${ANYCAST_GW}/32" dev br-private 2>/dev/null
        if ping -c 1 -W 3 "$ANYCAST_GW" >/dev/null 2>&1; then
            GW_IP="$ANYCAST_GW"
            logger -t parahub-heartbeat "Bee: no WAN, using anycast mesh gateway $ANYCAST_GW"
        else
            ip route del "${ANYCAST_GW}/32" dev br-private 2>/dev/null

            # Fallback: derive gateway IP from batman-adv gateway MAC
            GW_LINE=$(batctl gwl 2>/dev/null | grep '^\*' | head -1)
            if [ -n "$GW_LINE" ]; then
                GW_MAC=$(echo "$GW_LINE" | awk '{print $2}')
                O4=$(echo "$GW_MAC" | awk -F: '{printf "%d", "0x"$4}')
                O5=$(echo "$GW_MAC" | awk -F: '{printf "%d", "0x"$5}')
                CANDIDATE="10.${O4}.${O5}.1"
                ip route replace "${CANDIDATE}/32" dev br-private 2>/dev/null
                if ping -c 1 -W 3 "$CANDIDATE" >/dev/null 2>&1; then
                    GW_IP="$CANDIDATE"
                    logger -t parahub-heartbeat "Bee: no WAN, using mesh gateway $GW_IP (MAC $GW_MAC)"
                else
                    ip route del "${CANDIDATE}/32" dev br-private 2>/dev/null
                fi
            fi
        fi

        if [ -n "$GW_IP" ]; then
            ip route replace default via "$GW_IP" dev br-private 2>/dev/null
        fi

        # Ensure DNS upstream is set (WAN DHCP may have cleared it)
        mkdir -p /tmp/resolv.conf.d
        grep -q nameserver /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null || \
            printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >> /tmp/resolv.conf.d/resolv.conf.auto
    fi

    # Bee: try yggdrasil first (multicast-peered with bumblebees), fallback to public
    if ping6 -c 1 -W 3 <YGG_ADDR_MAIN> >/dev/null 2>&1; then
        RESPONSE=$(curl -s -m 10 -X POST \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer ${HEARTBEAT_KEY}" \
            -d "$PAYLOAD" \
            "${PARAHUB_API_YGG}" 2>/dev/null)
    fi
    if [ -z "$RESPONSE" ]; then
        RESPONSE=$(curl -s -m 10 -X POST \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer ${HEARTBEAT_KEY}" \
            -d "$PAYLOAD" \
            "${PARAHUB_API_PUBLIC}" 2>/dev/null)
    fi
else
    # Bumblebee: try yggdrasil first, fallback to public
    if ping6 -c 1 -W 3 <YGG_ADDR_MAIN> >/dev/null 2>&1; then
        RESPONSE=$(curl -s -m 10 -X POST \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer ${HEARTBEAT_KEY}" \
            -d "$PAYLOAD" \
            "${PARAHUB_API_YGG}" 2>/dev/null)
    fi
    if [ -z "$RESPONSE" ]; then
        RESPONSE=$(curl -s -m 10 -X POST \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer ${HEARTBEAT_KEY}" \
            -d "$PAYLOAD" \
            "${PARAHUB_API_PUBLIC}" 2>/dev/null)
    fi
fi

# Speed-tier rates (ph44): owner-set budgets from the backend — per-guest free
# tier (guest_kbps, applied where this node terminates the guest VLAN) and the
# host budget (host_mbps, the bat0 cap a bee/fallback node lives under, min
# over the island's donors). Persisted so boot-time hotplug shaping uses the
# last known values; a change re-applies the affected shaper immediately.
SPEED_ENABLED=0
/etc/init.d/parahub-speed enabled 2>/dev/null && SPEED_ENABLED=1
if [ -x /usr/bin/parahub-speed-control ] && [ -n "$RESPONSE" ]; then
    GUEST_KBPS=$(echo "$RESPONSE" | jsonfilter -e '$.rates.guest_kbps' 2>/dev/null)
    HOST_MBPS=$(echo "$RESPONSE" | jsonfilter -e '$.rates.host_mbps' 2>/dev/null)
    case "$GUEST_KBPS" in ''|*[!0-9]*) GUEST_KBPS="" ;; esac
    case "$HOST_MBPS" in ''|*[!0-9]*) HOST_MBPS="" ;; esac
    if [ -n "$GUEST_KBPS" ] && [ "$(cat /etc/parahub/guest_rate_kbps 2>/dev/null)" != "$GUEST_KBPS" ]; then
        echo "$GUEST_KBPS" > /etc/parahub/guest_rate_kbps
        if [ "$ROLE" != "bee" ] && [ "$SPEED_ENABLED" = "1" ]; then
            logger -t parahub-heartbeat "Guest rate changed to ${GUEST_KBPS} kbps, re-applying guest shaping"
            parahub-speed-control init
        fi
    fi
    if [ -n "$HOST_MBPS" ] && [ "$(cat /etc/parahub/host_rate_mbps 2>/dev/null)" != "$HOST_MBPS" ]; then
        echo "$HOST_MBPS" > /etc/parahub/host_rate_mbps
        if [ "$ROLE" = "bee" ]; then
            [ "$SPEED_ENABLED" = "1" ] && parahub-speed-control init_host
        elif tc qdisc show dev bat0 2>/dev/null | grep -q '^qdisc htb'; then
            # Bumblebee with an active mesh-fallback cap: refresh it
            parahub-speed-control init_host
        fi
        logger -t parahub-heartbeat "Host budget changed to ${HOST_MBPS} Mbps"
    fi
fi

# Sync paid_clients to speed control (Bumblebee only)
if [ "$ROLE" != "bee" ] && [ -x /usr/bin/parahub-speed-control ] && [ -n "$RESPONSE" ]; then
    PAID_IPS=$(echo "$RESPONSE" | jsonfilter -e '$.paid_clients[*]' 2>/dev/null)
    # Flush and re-add all paid IPs
    parahub-speed-control flush
    for IP in $PAID_IPS; do
        parahub-speed-control add "$IP"
    done
fi

# Per-guest shaping classes track DHCP leases (ph44): give every current guest
# lease its own class so the free tier is per guest, not shared. No-op unless
# guest shaping is applied and the lease set / rate actually changed.
if [ "$ROLE" != "bee" ] && [ "$SPEED_ENABLED" = "1" ] && [ -x /usr/bin/parahub-speed-control ]; then
    parahub-speed-control sync_guests
fi

# Sync Yggdrasil ACL whitelist (Bumblebee only)
if [ "$ROLE" != "bee" ] && [ -x /usr/bin/parahub-ygg-acl ] && [ -n "$RESPONSE" ]; then
    YGG_IPS=$(echo "$RESPONSE" | jsonfilter -e '$.ygg_allowed[*]' 2>/dev/null)
    # Init nftables table if not yet created (OTA from pre-ACL firmware)
    nft list table inet parahub_ygg >/dev/null 2>&1 || parahub-ygg-acl init
    # Sync allowed set
    parahub-ygg-acl sync $YGG_IPS
fi

# Sync guest-VLAN gateway role (Bumblebee only, ph35). The backend elects exactly
# one bumblebee to terminate the mesh guest VLAN; this node obeys the flag. An
# absent/false flag means relay-only (fail-safe: no DHCP race, no un-VPN'd hole).
if [ "$ROLE" != "bee" ] && [ -x /usr/bin/parahub-guest-gateway ] && [ -n "$RESPONSE" ]; then
    GUEST_GW=$(echo "$RESPONSE" | jsonfilter -e '$.guest_gateway' 2>/dev/null)
    if [ "$GUEST_GW" = "true" ]; then
        parahub-guest-gateway on
    else
        parahub-guest-gateway off
    fi
fi

# VPS gateway auto-configuration (Bumblebee only, skip if Mullvad is configured)
if [ "$ROLE" != "bee" ] && [ -n "$RESPONSE" ] && [ ! -f /etc/parahub/mullvad_account ]; then
    VPS_ENDPOINT=$(echo "$RESPONSE" | jsonfilter -e '$.vps_gateway.endpoint' 2>/dev/null)
    VPS_PUBKEY=$(echo "$RESPONSE" | jsonfilter -e '$.vps_gateway.public_key' 2>/dev/null)
    VPS_IP=$(echo "$RESPONSE" | jsonfilter -e '$.vps_gateway.assigned_ip' 2>/dev/null)
    VPS_KEEPALIVE=$(echo "$RESPONSE" | jsonfilter -e '$.vps_gateway.keepalive' 2>/dev/null)

    if [ -n "$VPS_ENDPOINT" ] && [ -n "$VPS_PUBKEY" ] && [ -n "$VPS_IP" ]; then
        /usr/bin/parahub-vps-setup "$VPS_ENDPOINT" "$VPS_PUBKEY" "$VPS_IP" "${VPS_KEEPALIVE:-25}"
    fi
fi

# Yggdrasil inbound self-heal (ph42, all roles). The backend TCP-probes this
# node's ygg:22 every 2 min and sets ygg_inbound_dead in the reply once a
# failure streak is confirmed — the wedge where outbound (heartbeats) works
# but inbound times out, leaving the node unmanageable. Previously the only
# cure was a human power cycle; these nodes are meant to be unattended.
# Escalation ladder on consecutive flagged heartbeats: 2nd -> restart
# yggdrasil, 5th (~15 min after the soft attempt) -> reboot. Guards: no
# action in the first 10 min of uptime (boot grace), reboot only past 30 min
# uptime (loop brake); an absent/false flag resets the streak, and the
# backend verdict TTLs out if its probe timer dies, so a stale "dead" can
# never keep cycling a healthy node. The flag also arrives via the public
# API fallback, so a fully dead yggdrasil still gets healed.
HEAL_STATE=/tmp/parahub-ygg-heal.count
if [ -n "$RESPONSE" ]; then
    INBOUND_DEAD=$(echo "$RESPONSE" | jsonfilter -e '$.ygg_inbound_dead' 2>/dev/null)
    if [ "$INBOUND_DEAD" = "true" ] && [ "$UPTIME" -gt 600 ]; then
        STREAK=$(( $(cat "$HEAL_STATE" 2>/dev/null || echo 0) + 1 ))
        echo "$STREAK" > "$HEAL_STATE"
        logger -t parahub-heartbeat "Backend reports ygg inbound dead (streak $STREAK)"
        if [ "$STREAK" = "2" ]; then
            logger -t parahub-heartbeat "Self-heal: restarting yggdrasil"
            /etc/init.d/yggdrasil restart
        elif [ "$STREAK" -ge 5 ] && [ "$UPTIME" -gt 1800 ]; then
            logger -t parahub-heartbeat "Self-heal: yggdrasil restart did not recover inbound, rebooting"
            reboot
        fi
    else
        rm -f "$HEAL_STATE"
    fi
fi
