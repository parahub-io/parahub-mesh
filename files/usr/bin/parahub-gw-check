#!/bin/sh
# Parahub Gateway Health Check
# 3-state logic:
#   1. WG active + own uplink → gw_mode=server (advertise as gateway, send GARP)
#   2. WG down (or no own uplink) + mesh gateway found → gw_mode=client + fallback routing through mesh
#   3. WG down + no mesh gateway → gw_mode=client (isolated, no guest internet)
#
# Run via cron every 2 minutes. Bumblebee only.

[ "$(cat /etc/parahub/role 2>/dev/null)" = "bumblebee" ] || exit 0

STATE_FILE="/tmp/mesh_gw_state"
GW_IP_FILE="/tmp/mesh_gw_ip"
ANYCAST_GW="10.250.250.1"
# fw4 auto-includes chain-pre/<chain>/*.nft at the top of that chain on every
# firewall reload. Rules inserted live into fw4 chains do NOT survive reloads
# (fw4 regenerates its table from scratch), and reloads happen behind our back:
# the https-dns-proxy restart below triggers one via procd_set_config_changed.
FW_INCLUDE="/usr/share/nftables.d/chain-pre/forward_guest/30-mesh-gw-fallback.nft"
CURRENT_STATE=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")

# Read own subnets from /etc/parahub/keys
# Provides: GUEST_SUBNET (e.g. "10.131.196.0/24"), PRIVATE_SUBNET (e.g. "10.236.248.0/24")
. /etc/parahub/keys 2>/dev/null

# Detect guest interface name
GUEST_IFACE=$(ubus call network.interface.guest status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)

# ---- Check WireGuard health ----
WG_OK=0
if command -v wg >/dev/null 2>&1; then
    LAST_HS=$(wg show all latest-handshakes 2>/dev/null | awk '{print $NF}' | sort -rn | head -1)
    if [ -n "$LAST_HS" ] && [ "$LAST_HS" -gt 0 ] 2>/dev/null; then
        NOW=$(date +%s)
        AGE=$((NOW - LAST_HS))
        # Handshake within last 5 minutes = alive
        [ "$AGE" -lt 300 ] && WG_OK=1
    fi
fi

# A handshake achieved through the mesh fallback itself must not promote this
# node to server: without an own uplink, server mode tears down the fallback
# default route, the WG endpoint becomes unreachable again and guests get
# blackholed until the handshake goes stale — a permanent ~8 min
# server↔mesh_fallback oscillation (WAN-less FC10 incident, 2026-07-04). Only
# trust the handshake if a default route exists that does not go via the mesh.
if [ "$WG_OK" = "1" ]; then
    if ! ip -4 route 2>/dev/null | grep '^default' | grep -qv 'br-private'; then
        WG_OK=0
        [ "$CURRENT_STATE" = "server" ] && logger -t parahub-gw "WG handshake fresh but no own uplink (default route only via mesh), demoting to client"
    fi
fi

# ---- Guest forward rule (guest→br-private, otherwise hit by reject_to_lan) ----
guest_forward_rule_present() {
    [ -f "$FW_INCLUDE" ] && return 0
    nft list chain inet fw4 forward_guest 2>/dev/null | grep -q 'mesh-gw-fallback'
}

install_guest_forward_rule() {
    if [ -z "$GUEST_IFACE" ]; then
        logger -t parahub-gw "WARNING: guest interface unknown (ubus), cannot ensure guest forward rule"
        return
    fi
    # Scope the fallback opening to non-local destinations. Guests must reach the
    # mesh gateway (a different 10.x/24) and the internet beyond it, but NOT this
    # node's own private LAN — an unscoped accept silently drops guest<->LAN
    # isolation for the whole fallback episode (permanent on WAN-less extenders,
    # ph31+). The gateway and internet are outside PRIVATE_SUBNET, so excluding
    # it keeps fallback working while restoring isolation.
    local excl=""
    [ -n "$PRIVATE_SUBNET" ] && excl="ip daddr != $PRIVATE_SUBNET "
    local rule="iifname \"$GUEST_IFACE\" oifname \"br-private\" ${excl}accept comment \"mesh-gw-fallback\""
    if [ "$(cat "$FW_INCLUDE" 2>/dev/null)" != "$rule" ]; then
        mkdir -p "${FW_INCLUDE%/*}"
        echo "$rule" > "$FW_INCLUDE"
    fi
    if ! nft list chain inet fw4 forward_guest 2>/dev/null | grep -q 'mesh-gw-fallback'; then
        nft insert rule inet fw4 forward_guest iifname "$GUEST_IFACE" oifname "br-private" ${excl}accept comment \"mesh-gw-fallback\"
        logger -t parahub-gw "Installed guest forward rule for mesh fallback (iface $GUEST_IFACE)"
    fi
}

remove_guest_forward_rule() {
    rm -f "$FW_INCLUDE"
    local h
    for h in $(nft -a list chain inet fw4 forward_guest 2>/dev/null | grep 'mesh-gw-fallback' | awk '{print $NF}'); do
        nft delete rule inet fw4 forward_guest handle "$h"
    done
}

# ---- Host budget cap during mesh fallback (ph44) ----
# In mesh_fallback this node's own private (and SNAT'd guest) traffic rides
# another island member's uplink — the same freeride a bee's bat0 cap bounds.
# Apply the identical host budget here; without it a WAN-less bumblebee is an
# uncapped bee. Asserted every fallback tick, removed in server/isolated.
ensure_host_cap() {
    tc qdisc show dev bat0 2>/dev/null | grep -q '^qdisc htb' && return
    /usr/bin/parahub-speed-control init_host
    logger -t parahub-gw "Mesh fallback: host budget cap applied on bat0"
}

drop_host_cap() {
    tc qdisc show dev bat0 2>/dev/null | grep -q '^qdisc htb' || return
    /usr/bin/parahub-speed-control stop_host
    logger -t parahub-gw "Left mesh fallback: host budget cap removed"
}

# ---- Cleanup mesh fallback routing ----
cleanup_mesh_fallback() {
    local old_gw
    old_gw=$(cat "$GW_IP_FILE" 2>/dev/null)

    # Remove mesh fallback nftables table (masquerade)
    nft delete table inet mesh_gw_fallback 2>/dev/null

    remove_guest_forward_rule

    # Remove mesh default routes and host route to gateway
    [ -n "$old_gw" ] && ip route del default via "$old_gw" dev br-private table 100 2>/dev/null
    [ -n "$old_gw" ] && ip route del "$old_gw/32" dev br-private 2>/dev/null
    ip route del default dev br-private metric 500 2>/dev/null

    rm -f "$GW_IP_FILE"
}

# ---- STATE 1: WireGuard active → server mode ----
if [ "$WG_OK" = "1" ]; then
    # Clean up mesh fallback if was active
    if [ "$CURRENT_STATE" = "mesh_fallback" ]; then
        cleanup_mesh_fallback
        # cleanup_mesh_fallback removed the mesh-fallback default; restore the
        # active WG's default in table 100 (netifd added it at ifup but the
        # earlier 'ip route replace' during fallback overwrote it).
        ACTIVE_WG=$(wg show all latest-handshakes 2>/dev/null | sort -k3 -rn | awk 'NR==1{print $1}')
        [ -n "$ACTIVE_WG" ] && ip route replace default dev "$ACTIVE_WG" table 100
        logger -t parahub-gw "WireGuard restored, removed mesh fallback (table 100 → $ACTIVE_WG)"
    elif guest_forward_rule_present; then
        # Stale after a reboot mid-fallback (/tmp state lost): the include
        # would keep re-opening guest→private on every firewall reload.
        remove_guest_forward_rule
        logger -t parahub-gw "Removed stale mesh fallback guest forward rule"
    fi

    # batman-adv's gateway DHCP redirect is NOT VLAN-aware: every gw_mode=client
    # node unicast-redirects DHCP — including guest (bat0.10) DISCOVERs — to the
    # batman-elected gw_mode=server, not to the untagged bat0 alone. Only the
    # elected guest terminator serves guest DHCP, so any OTHER server silently
    # black-holes guest leases: relay clients hang on "obtaining IP" and roam to
    # the terminator's own AP (home incident 2026-07-07, two WAN+VPN bumblebees
    # both became server, clients redirected guest DHCP to the non-terminator).
    # Gate ONLY gw_mode on being that terminator — identified by guest DHCP being
    # enabled (dhcp.guest.ignore != 1, toggled by the backend election via
    # parahub-guest-gateway). A healthy non-terminator uses gw_mode=off so guest
    # DISCOVERs are never redirected to it (they flood the VLAN and reach the
    # terminator, or a gw_mode=client node redirects them to the terminator, the
    # sole server). It KEEPS the anycast IP + mesh return route: gw_mode is
    # independent of the anycast-based internet-gateway role (nearest server
    # answers 10.250.250.1, forwarding/masquerade come from the firewall wan
    # zone), so every WG-healthy bumblebee stays a bee gateway — dropping them
    # would strand bees routing through a non-terminator.
    CURRENT_MODE=$(batctl gw_mode 2>/dev/null | awk '{print $1}')
    if [ "$(uci -q get dhcp.guest.ignore)" != "1" ]; then
        if [ "$CURRENT_MODE" != "server" ]; then
            batctl gw_mode server
            logger -t parahub-gw "guest terminator + WG active → gw_mode=server"
        fi
    else
        if [ "$CURRENT_MODE" != "off" ]; then
            batctl gw_mode off
            logger -t parahub-gw "WG active but not guest terminator → gw_mode=off (guest DHCP would black-hole here)"
        fi
    fi

    # Mesh return route: client nodes have different 10.x.y.0/24 subnets but
    # share L2 via bat0/br-private. Without this, reply packets to mesh clients
    # go to WAN instead of back through batman-adv. Lower metric than local /24
    # routes. Anycast gateway IP: bee nodes discover us via this well-known
    # address. Both kept regardless of gw_mode — a non-terminator is still an
    # internet gateway, just not a guest-DHCP redirect target.
    ip route replace 10.0.0.0/8 dev br-private metric 500
    ip addr replace "$ANYCAST_GW/32" dev br-private 2>/dev/null

    drop_host_cap
    echo "server" > "$STATE_FILE"
    exit 0
fi

# WG is down — remove anycast gateway IP (only active servers should have it)
ip addr del "$ANYCAST_GW/32" dev br-private 2>/dev/null

# ---- WG is down, ensure client mode ----
CURRENT_MODE=$(batctl gw_mode 2>/dev/null | awk '{print $1}')
[ "$CURRENT_MODE" != "client" ] && batctl gw_mode client

# ---- Find best mesh gateway from batctl ----
GW_MAC=""
GW_LINE=$(batctl gwl 2>/dev/null | grep '^\*' | head -1)
if [ -n "$GW_LINE" ]; then
    # Format: "* aa:bb:cc:dd:ee:ff (255) ... [B.A.T.M.A.N. V]"
    GW_MAC=$(echo "$GW_LINE" | awk '{print $2}')
fi

if [ -z "$GW_MAC" ]; then
    # ---- STATE 3: No gateway — isolated ----
    if [ "$CURRENT_STATE" = "mesh_fallback" ]; then
        cleanup_mesh_fallback
        logger -t parahub-gw "Mesh gateway lost, guest internet disabled"
    elif guest_forward_rule_present; then
        remove_guest_forward_rule
    fi
    drop_host_cap
    echo "isolated" > "$STATE_FILE"
    exit 0
fi

# ---- STATE 2: Derive gateway IP from MAC and set up fallback ----
# MAC octets 4,5 → private subnet: 10.{octet4_dec}.{octet5_dec}.1
O4=$(echo "$GW_MAC" | awk -F: '{printf "%d", "0x"$4}')
O5=$(echo "$GW_MAC" | awk -F: '{printf "%d", "0x"$5}')
GW_IP="10.${O4}.${O5}.1"

# Add host route so we can reach gateway IP across mesh (different L3 subnets, same L2 via batman-adv)
ip route replace "$GW_IP/32" dev br-private

# Check if gateway is reachable on mesh
if ! ping -c 1 -W 2 "$GW_IP" >/dev/null 2>&1; then
    ip route del "$GW_IP/32" dev br-private 2>/dev/null
    # MAC-derived IP failed — try anycast gateway (handles mismatched NODE_MAC)
    ip route replace "$ANYCAST_GW/32" dev br-private 2>/dev/null
    if ping -c 1 -W 2 "$ANYCAST_GW" >/dev/null 2>&1; then
        GW_IP="$ANYCAST_GW"
        logger -t parahub-gw "MAC-derived IP unreachable, using anycast gateway $ANYCAST_GW"
    else
        ip route del "$ANYCAST_GW/32" dev br-private 2>/dev/null
        if [ "$CURRENT_STATE" = "mesh_fallback" ]; then
            cleanup_mesh_fallback
        elif guest_forward_rule_present; then
            remove_guest_forward_rule
        fi
        drop_host_cap
        logger -t parahub-gw "Mesh gateway unreachable (MAC-derived + anycast), skipping fallback"
        echo "isolated" > "$STATE_FILE"
        exit 0
    fi
fi

OLD_GW=$(cat "$GW_IP_FILE" 2>/dev/null)

# If gateway changed, clean up old one first (BEFORE updating GW_IP_FILE,
# since cleanup reads the file to determine which routes to remove)
if [ "$CURRENT_STATE" = "mesh_fallback" ] && [ "$OLD_GW" != "$GW_IP" ]; then
    cleanup_mesh_fallback
    logger -t parahub-gw "Mesh gateway changed: $OLD_GW -> $GW_IP"
fi

echo "$GW_IP" > "$GW_IP_FILE"

# Routing, NAT and the guest forward rule are (re)asserted on EVERY tick, not
# only on the state transition: fw4 reloads drop the live forward rule, netifd
# events on vps_gateway (ip4table=100) can clobber the table-100 default, and
# a one-shot setup left any such loss unrepaired for the rest of the episode.
# Everything below is idempotent.
ip route replace default via "$GW_IP" dev br-private table 100
ip route replace default via "$GW_IP" dev br-private metric 500

# Masquerade guest + private traffic to br-private IP (gateway only knows mesh L2 addresses).
# Without private SNAT, Parahub clients (10.P1.P2.x) hit the mesh peer with their own src,
# peer has no return route → reply lost → "no internet on Parahub WiFi".
if ! nft list table inet mesh_gw_fallback >/dev/null 2>&1; then
    nft add table inet mesh_gw_fallback
    nft add chain inet mesh_gw_fallback postrouting '{ type nat hook postrouting priority 100; }'
fi
# Re-assert the SNAT rules every tick (idempotent). Under the old create-once
# gate, a table first created while the subnet vars were empty stayed ruleless
# forever, silently killing fallback egress. Flushing only affects NEW flows in
# a sub-ms window; conntrack keeps the NAT binding for established connections.
nft flush chain inet mesh_gw_fallback postrouting 2>/dev/null
[ -n "$GUEST_SUBNET" ] && nft add rule inet mesh_gw_fallback postrouting oifname "br-private" ip saddr "$GUEST_SUBNET" masquerade
[ -n "$PRIVATE_SUBNET" ] && nft add rule inet mesh_gw_fallback postrouting oifname "br-private" ip saddr "$PRIVATE_SUBNET" masquerade

install_guest_forward_rule
ensure_host_cap

if [ "$CURRENT_STATE" != "mesh_fallback" ] || [ "$OLD_GW" != "$GW_IP" ]; then
    # Restart DoH proxy — it may have stopped when WAN was down.
    # NB: its init triggers an async fw4 reload (procd_set_config_changed
    # firewall) — survivable now that the forward rule ships as an include.
    /etc/init.d/https-dns-proxy restart 2>/dev/null

    logger -t parahub-gw "Mesh fallback active via gateway $GW_IP (MAC $GW_MAC)"
fi

echo "mesh_fallback" > "$STATE_FILE"
