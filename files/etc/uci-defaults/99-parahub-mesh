#!/bin/sh
# Parahub Mesh Node — Zero-Touch First Boot Configuration
# This script runs once on first boot via uci-defaults mechanism.
# It configures: batman-adv mesh, dual-band WiFi (private+public), firewall zones, SQM shaping.
#
# Roles:
#   bumblebee (L3 Gateway) — full stack: yggdrasil, Mullvad VPN, guest isolation, speed control, DoH
#   bee (L2 Transport)     — minimal: batman-adv mesh relay, heartbeat

# Read firmware role (written by build.sh)
ROLE=$(cat /etc/parahub/role 2>/dev/null || echo "bumblebee")

# ============================================================================
# 1. IDENTITY GENERATION
# ============================================================================

PRIVATE_SSID="Parahub"
MESH_ID="parahub.io/mesh"
PUBLIC_SSID="parahub.io/free"

if [ -f /etc/parahub/keys ] && grep -q "^NODE_MAC=" /etc/parahub/keys; then
    # OTA update — /etc/parahub/keys preserved by sysupgrade.conf
    # Load existing identity to keep hostname/MAC stable across firmware updates
    . /etc/parahub/keys
    BASE_MAC="$NODE_MAC"
    NODE_SUFFIX=$(echo "$BASE_MAC" | awk -F: '{print toupper($5$6)}')
    HOSTNAME="Parahub-${NODE_SUFFIX}"
    # keys stores PRIVATE_SUBNET=10.X.Y.0/24 — extract network addr and gateway
    PRIV_SUBNET="${PRIVATE_SUBNET%/24}"
    PRIV_IP="${PRIV_SUBNET%0}1"
    GUEST_SUBNET="${GUEST_SUBNET%/24}"
    GUEST_IP="${GUEST_SUBNET%0}1"

    # Preserve an admin-customized private WiFi identity across the wireless
    # regeneration below. Sections 5/10 rebuild wireless from scratch on every
    # run (including OTA), which would otherwise reset SSID/key to build-time
    # defaults. sysupgrade restores /etc/config/wireless before us, so the
    # running values are the source of truth. Password also survives via keys'
    # PRIVATE_WIFI_KEY, but SSID is only in live UCI (the wifi-config API does
    # not persist it to keys), so read both from UCI for one uniform path.
    LIVE_SSID=$(uci -q get wireless.private_5g.ssid || uci -q get wireless.private_2g.ssid)
    LIVE_KEY=$(uci -q get wireless.private_5g.key || uci -q get wireless.private_2g.key)
    [ -n "$LIVE_SSID" ] && PRIVATE_SSID="$LIVE_SSID"
    [ -n "$LIVE_KEY" ] && PRIVATE_KEY="$LIVE_KEY"

    logger -t parahub-mesh "OTA: preserving identity ${HOSTNAME} (MAC ${BASE_MAC})"
else
    # Fresh flash — detect MAC from hardware
    # Get hardware MAC with retry (some devices initialize NICs slowly at first boot)
    BASE_MAC=""
    for attempt in 1 2 3 4 5; do
        for iface in br-lan eth0 eth1 eth2; do
            mac=$(cat /sys/class/net/$iface/address 2>/dev/null)
            if [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ]; then
                BASE_MAC="$mac"
                break 2
            fi
        done
        [ "$attempt" -lt 5 ] && sleep 1
    done
    # Fallback: random locally-administered MAC (02:xx:xx:xx:xx:xx)
    if [ -z "$BASE_MAC" ] || [ "$BASE_MAC" = "00:00:00:00:00:00" ]; then
        BASE_MAC=$(hexdump -n 5 -e '/1 ":%02x"' /dev/urandom | sed 's/^:/02:/')
    fi

    # Last 4 hex digits of MAC for unique suffix
    NODE_SUFFIX=$(echo "$BASE_MAC" | awk -F: '{print toupper($5$6)}')
    HOSTNAME="Parahub-${NODE_SUFFIX}"

    # ============================================================================
    # 2. SUBNET GENERATION (collision avoidance from MAC octets)
    # ============================================================================

    # Private: octets 4,5 → 10.P1.P2.0/24
    PRIV_O1=$(echo "$BASE_MAC" | awk -F: '{printf "%d", "0x"$4}')
    PRIV_O2=$(echo "$BASE_MAC" | awk -F: '{printf "%d", "0x"$5}')

    # Guest: octets 2,3 → 10.G1.G2.0/24 (guaranteed different from private since different MAC positions)
    GUEST_O1=$(echo "$BASE_MAC" | awk -F: '{printf "%d", "0x"$2}')
    GUEST_O2=$(echo "$BASE_MAC" | awk -F: '{printf "%d", "0x"$3}')

    # Avoid 0 and 255 in second octet (reserved)
    [ "$PRIV_O1" -eq 0 ] && PRIV_O1=1
    [ "$PRIV_O1" -eq 255 ] && PRIV_O1=254
    [ "$GUEST_O1" -eq 0 ] && GUEST_O1=2
    [ "$GUEST_O1" -eq 255 ] && GUEST_O1=253

    PRIV_SUBNET="10.${PRIV_O1}.${PRIV_O2}.0"
    PRIV_IP="10.${PRIV_O1}.${PRIV_O2}.1"
    GUEST_SUBNET="10.${GUEST_O1}.${GUEST_O2}.0"
    GUEST_IP="10.${GUEST_O1}.${GUEST_O2}.1"
fi

# ============================================================================
# 3. KEY GENERATION
# ============================================================================

# Shared private WiFi key — default for seamless 802.11r roaming. On OTA the
# admin-set value captured above (or keys' PRIVATE_WIFI_KEY) wins; only a fresh
# flash falls back to the default.
PRIVATE_KEY="${PRIVATE_KEY:-parahub.io}"
# Shared mesh SAE key — same across all Parahub nodes for auto-peering
MESH_KEY="ndIPclyqSn9LaCki"
# Random root password for SSH + LuCI (unique per node). Reuse the existing one
# on OTA (sourced from keys above) so it stays stable across updates instead of
# rotating every night; generate a fresh one only on a first flash.
ROOT_PASSWORD="${ROOT_PASSWORD:-$(head -c 128 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 16)}"

mkdir -p /etc/parahub
cat > /etc/parahub/keys <<KEYS_EOF
# Parahub Mesh Node Keys — Generated at first boot
# Node: ${HOSTNAME}
# Role: ${ROLE}
# Date: $(date -u +%Y-%m-%dT%H:%M:%SZ)
PRIVATE_WIFI_KEY=${PRIVATE_KEY}
MESH_SAE_KEY=${MESH_KEY}
PRIVATE_SSID=${PRIVATE_SSID}
PRIVATE_SUBNET=${PRIV_SUBNET}/24
GUEST_SUBNET=${GUEST_SUBNET}/24
NODE_MAC=${BASE_MAC}
ROOT_PASSWORD=${ROOT_PASSWORD}
KEYS_EOF
chmod 600 /etc/parahub/keys

# Set root password (secures SSH + LuCI)
echo -e "${ROOT_PASSWORD}\n${ROOT_PASSWORD}" | passwd root >/dev/null 2>&1

# Ensure dropbear directory has strict permissions (required for key auth)
chmod 700 /etc/dropbear

# Generate WireGuard keypair for VPS gateway (Bumblebee only)
if [ "$ROLE" != "bee" ]; then
    if [ ! -f /etc/parahub/wg_vps_private.key ]; then
        umask 077
        wg genkey > /etc/parahub/wg_vps_private.key
        wg pubkey < /etc/parahub/wg_vps_private.key > /etc/parahub/wg_vps_public.key
    fi
fi

# ============================================================================
# 4. NETWORK CONFIGURATION
# ============================================================================

# --- Port mapping (written by build.sh per device) ---
PORT_MAP=$(cat /etc/parahub/port_map 2>/dev/null || echo "eth0:lan eth1:wan")
if [ "$PORT_MAP" = "dsa" ]; then
    # DSA switch (ax53u) — individual ports
    LAN_PORTS="lan1 lan2 lan3 lan4"
    WAN_DEV="wan"
else
    # Parse port map: "eth0:wan eth1:lan" → extract LAN and WAN
    LAN_PORTS=""
    WAN_DEV=""
    for mapping in $PORT_MAP; do
        port="${mapping%%:*}"
        role="${mapping##*:}"
        if [ "$role" = "lan" ]; then
            LAN_PORTS="$port"
        elif [ "$role" = "wan" ]; then
            WAN_DEV="$port"
        fi
    done
    # Fallbacks must NOT collide with each other — single-port devices (e.g. AP3000 Outdoor:
    # port_map="eth0:wan") have only WAN, no LAN ethernet. Putting eth0 in both WAN and the
    # private bridge mostly L2 with WAN → clients pick up provider DHCP.
    [ -z "$LAN_PORTS" ] && [ "$WAN_DEV" != "eth0" ] && LAN_PORTS="eth0"
    [ -z "$WAN_DEV" ] && [ "$LAN_PORTS" != "eth1" ] && WAN_DEV="eth1"
fi

# Delete default OpenWrt br-lan/lan (conflicts with our br-private)
uci -q delete network.lan 2>/dev/null || true
# Find and delete br-lan device
for i in 0 1 2 3 4; do
    name=$(uci -q get "network.@device[$i].name" 2>/dev/null)
    if [ "$name" = "br-lan" ]; then
        uci delete "network.@device[$i]"
        break
    fi
done

# Clear policy rules/routes from any previous run before the branches re-add
# them. This script re-runs on every OTA, and the guest `add network rule` /
# `add network route` below are additive — without this wipe they duplicate on
# every update (FC10 had accumulated 21 identical guest rules by 2026-07-04).
# The firewall section already wipes-then-rebuilds; network must do the same.
# Only uci-defaults writes UCI @rule/@route here (netifd's WG policy rules are
# runtime-only), and the feature reconcile re-adds the LAN-VPN rule if enabled.
while uci -q delete network.@rule[0]; do :; done
while uci -q delete network.@route[0]; do :; done

if [ "$ROLE" = "bee" ]; then
    # --- Bee: minimal network (bat0 gw_mode=client, no GRE6, no guest, no policy routing) ---
    uci batch <<-NET_EOF
# --- loopback ---
set network.loopback=interface
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'

# --- bat0 (batman-adv, client mode — uses Bumblebee as gateway) ---
set network.bat0=interface
set network.bat0.proto='batadv'
set network.bat0.routing_algo='BATMAN_V'
set network.bat0.aggregated_ogms='1'
set network.bat0.bridge_loop_avoidance='1'
set network.bat0.distributed_arp_table='1'
set network.bat0.gw_mode='client'
set network.bat0.hop_penalty='15'
set network.bat0.orig_interval='1000'

# --- bat0 hardif for mesh0 (2.4GHz mesh) ---
set network.bat0_hardif_mesh0=interface
set network.bat0_hardif_mesh0.proto='batadv_hardif'
set network.bat0_hardif_mesh0.master='bat0'

# --- bat0 hardif for mesh1 (5GHz mesh) ---
set network.bat0_hardif_mesh1=interface
set network.bat0_hardif_mesh1.proto='batadv_hardif'
set network.bat0_hardif_mesh1.master='bat0'

# --- guest VLAN over batman (bat0.10): carries free/guest traffic mesh-wide to
#     a bumblebee's guest network (-> VPN), off the private L2 and off raw WAN.
#     batman-adv is VLAN-aware, so VLAN 10 rides the same mesh as untagged bat0
#     (private) but stays a separate L2 domain end-to-end. ---
set network.bat0_guest=device
set network.bat0_guest.type='8021q'
set network.bat0_guest.ifname='bat0'
set network.bat0_guest.vid='10'
set network.bat0_guest.name='bat0.10'

# --- private bridge (bat0 + LAN ethernet) ---
set network.private_dev=device
set network.private_dev.type='bridge'
set network.private_dev.name='br-private'
delete network.private_dev.ports
add_list network.private_dev.ports='bat0'

set network.private=interface
set network.private.device='br-private'
set network.private.proto='static'
set network.private.ipaddr='${PRIV_IP}'
set network.private.netmask='255.255.255.0'

# --- guest VLAN bridge (bat0.10 + free AP), L2 only: free clients ride the VLAN
#     across the mesh to a bumblebee's guest network for DHCP + VPN, so they
#     never land on the private L2 or a raw WAN (closes the bee free-SSID hole) ---
set network.guest_dev=device
set network.guest_dev.type='bridge'
set network.guest_dev.name='br-guest'
delete network.guest_dev.ports
add_list network.guest_dev.ports='bat0.10'
set network.guest=interface
set network.guest.device='br-guest'
set network.guest.proto='none'

# --- wan (DHCP, create if missing) ---
set network.wan=interface
set network.wan.device='${WAN_DEV}'
set network.wan.proto='dhcp'
NET_EOF

    # Attach LAN ethernet: normally as bridge ports of br-private, but if wired
    # mesh was enabled (marker preserved across OTA via sysupgrade.conf), attach
    # them as batman-adv hardifs instead — mirrors the iot wired-mesh-toggle so
    # the choice survives the config regeneration on OTA.
    if [ -f /etc/parahub/wired_mesh_enabled ]; then
        WM_IDX=0
        for port in $LAN_PORTS; do
            uci set network.bat0_hardif_eth${WM_IDX}=interface
            uci set network.bat0_hardif_eth${WM_IDX}.proto='batadv_hardif'
            uci set network.bat0_hardif_eth${WM_IDX}.master='bat0'
            uci set network.bat0_hardif_eth${WM_IDX}.device="$port"
            WM_IDX=$((WM_IDX + 1))
        done
    else
        for port in $LAN_PORTS; do
            uci add_list network.private_dev.ports="$port"
        done
    fi

else
    # --- Bumblebee: full network (gw_mode starts as client, promoted to server by gw-check when Mullvad is up) ---
    uci batch <<-NET_EOF
# --- loopback ---
set network.loopback=interface
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'

# --- bat0 (batman-adv, starts as client — gw-check promotes to server when Mullvad is active) ---
set network.bat0=interface
set network.bat0.proto='batadv'
set network.bat0.routing_algo='BATMAN_V'
set network.bat0.aggregated_ogms='1'
set network.bat0.bridge_loop_avoidance='1'
set network.bat0.distributed_arp_table='1'
set network.bat0.gw_mode='client'
set network.bat0.hop_penalty='15'
set network.bat0.orig_interval='1000'

# --- bat0 hardif for mesh0 (2.4GHz mesh) ---
set network.bat0_hardif_mesh0=interface
set network.bat0_hardif_mesh0.proto='batadv_hardif'
set network.bat0_hardif_mesh0.master='bat0'

# --- bat0 hardif for mesh1 (5GHz mesh) ---
set network.bat0_hardif_mesh1=interface
set network.bat0_hardif_mesh1.proto='batadv_hardif'
set network.bat0_hardif_mesh1.master='bat0'

# --- guest VLAN over batman (bat0.10): carries free/guest traffic mesh-wide to
#     a bumblebee's guest network (-> VPN), off the private L2 and off raw WAN.
#     batman-adv is VLAN-aware, so VLAN 10 rides the same mesh as untagged bat0
#     (private) but stays a separate L2 domain end-to-end. ---
set network.bat0_guest=device
set network.bat0_guest.type='8021q'
set network.bat0_guest.ifname='bat0'
set network.bat0_guest.vid='10'
set network.bat0_guest.name='bat0.10'

# --- private bridge (bat0 + LAN ethernet) ---
set network.private_dev=device
set network.private_dev.type='bridge'
set network.private_dev.name='br-private'
delete network.private_dev.ports
add_list network.private_dev.ports='bat0'

set network.private=interface
set network.private.device='br-private'
set network.private.proto='static'
set network.private.ipaddr='${PRIV_IP}'
set network.private.netmask='255.255.255.0'

# --- guest bridge (bat0.10 guest VLAN + guest AP): terminate the mesh-wide
#     guest VLAN here so free/guest traffic from ANY node (bees, WAN-less
#     extenders) exits via THIS bumblebee's VPN (guest zone -> table 100),
#     fully isolated from the private L2 ---
set network.guest_dev=device
set network.guest_dev.type='bridge'
set network.guest_dev.name='br-guest'
delete network.guest_dev.ports
add_list network.guest_dev.ports='bat0.10'
set network.guest=interface
set network.guest.device='br-guest'
set network.guest.proto='static'
set network.guest.ipaddr='${GUEST_IP}'
set network.guest.netmask='255.255.255.0'

# --- wan (DHCP, create if missing) ---
set network.wan=interface
set network.wan.device='${WAN_DEV}'
set network.wan.proto='dhcp'

# --- VPS gateway WireGuard (disabled until heartbeat activates it) ---
set network.vps_gateway=interface
set network.vps_gateway.proto='wireguard'
set network.vps_gateway.private_key='$(cat /etc/parahub/wg_vps_private.key)'
set network.vps_gateway.mtu='1420'
set network.vps_gateway.ip4table='100'
set network.vps_gateway.auto='0'
set network.vps_gateway.nohostroute='1'

# --- Policy routing: guest traffic → table 100 ---
add network rule
set network.@rule[-1].src='${GUEST_SUBNET}/24'
set network.@rule[-1].lookup='100'
set network.@rule[-1].priority='100'

# --- Connected route for guest subnet in table 100 ---
# Without this, router's own responses (DNS etc.) with src in guest subnet
# get routed through VPN instead of directly back to the client
add network route
set network.@route[-1].interface='guest'
set network.@route[-1].target='${GUEST_SUBNET}/24'
set network.@route[-1].table='100'
NET_EOF

    # Attach LAN ethernet: normally as bridge ports of br-private, but if wired
    # mesh was enabled (marker preserved across OTA via sysupgrade.conf), attach
    # them as batman-adv hardifs instead — mirrors the iot wired-mesh-toggle so
    # the choice survives the config regeneration on OTA.
    if [ -f /etc/parahub/wired_mesh_enabled ]; then
        WM_IDX=0
        for port in $LAN_PORTS; do
            uci set network.bat0_hardif_eth${WM_IDX}=interface
            uci set network.bat0_hardif_eth${WM_IDX}.proto='batadv_hardif'
            uci set network.bat0_hardif_eth${WM_IDX}.master='bat0'
            uci set network.bat0_hardif_eth${WM_IDX}.device="$port"
            WM_IDX=$((WM_IDX + 1))
        done
    else
        for port in $LAN_PORTS; do
            uci add_list network.private_dev.ports="$port"
        done
    fi
fi

uci commit network

# ============================================================================
# 5. WIRELESS CONFIGURATION
# ============================================================================

# Detect radios dynamically
RADIOS=$(uci show wireless | grep '=wifi-device' | cut -d'=' -f1 | cut -d'.' -f2)

# Determine which radio is 2.4GHz and which is 5GHz
RADIO_2G=""
RADIO_5G=""

for radio in $RADIOS; do
    band=$(uci -q get "wireless.${radio}.band" 2>/dev/null || echo "")
    htmode=$(uci -q get "wireless.${radio}.htmode" 2>/dev/null || echo "")

    if [ "$band" = "2g" ]; then
        RADIO_2G="$radio"
    elif [ "$band" = "5g" ]; then
        RADIO_5G="$radio"
    else
        # Fallback: detect from htmode or channel
        channel=$(uci -q get "wireless.${radio}.channel" 2>/dev/null || echo "0")
        if [ "$channel" -le 14 ] 2>/dev/null; then
            RADIO_2G="$radio"
        else
            RADIO_5G="$radio"
        fi
    fi
done

# Fallback: if only one radio detected, use it for both
DUAL_BAND=true
SINGLE_BAND_5G=false
if [ -z "$RADIO_2G" ] && [ -n "$RADIO_5G" ]; then
    # 5GHz-only device (e.g. TP-Link CPE710). Alias so the single-radio code
    # path runs, but remember the real band: its mesh must sit on the shared
    # 5GHz channel (36), NOT channel 1, or it can't peer with dual-band nodes.
    RADIO_2G="$RADIO_5G"
    DUAL_BAND=false
    SINGLE_BAND_5G=true
fi
if [ -z "$RADIO_5G" ] && [ -n "$RADIO_2G" ]; then
    RADIO_5G="$RADIO_2G"
    DUAL_BAND=false
fi

# Remove all existing wifi-iface sections
while uci -q delete wireless.@wifi-iface[0]; do :; done

# Enable radios and set fixed channels (all nodes must share same channel for mesh peering)
for radio in $RADIOS; do
    uci -q delete "wireless.${radio}.disabled" 2>/dev/null || true
done

# Fixed channels — all mesh nodes must be on the same channel per band
# 2.4GHz: channel 1 (DFS-free, least congested of 1/6/11)
# 5GHz: channel 36 (DFS-free, universal chipset support)
if [ "$DUAL_BAND" = "true" ]; then
    [ -n "$RADIO_2G" ] && uci set "wireless.${RADIO_2G}.channel=1"
    [ -n "$RADIO_5G" ] && uci set "wireless.${RADIO_5G}.channel=36"
elif [ "$SINGLE_BAND_5G" = "true" ]; then
    # 5GHz-only: join the dual-band nodes' 5GHz mesh on channel 36
    uci set "wireless.${RADIO_2G}.channel=36"
else
    # 2.4GHz-only (e.g. AR300M16): shared 2.4GHz channel 1
    uci set "wireless.${RADIO_2G}.channel=1"
fi

# --- 2.4GHz radio: mesh backhaul + parahub.io/free AP ---
if [ -n "$RADIO_2G" ]; then
    # Mesh interface on 2.4GHz
    uci batch <<-WIFI_2G_MESH
set wireless.mesh_2g=wifi-iface
set wireless.mesh_2g.device='${RADIO_2G}'
set wireless.mesh_2g.mode='mesh'
set wireless.mesh_2g.mesh_id='${MESH_ID}'
set wireless.mesh_2g.mesh_fwding='0'
set wireless.mesh_2g.encryption='sae'
set wireless.mesh_2g.key='${MESH_KEY}'
set wireless.mesh_2g.network='bat0_hardif_mesh0'
WIFI_2G_MESH

    # parahub.io/free is OPEN (no encryption) — workaround for OpenWrt 25.12.x
    # OWE bug. OWE config makes hostapd add_iface fail at boot on filogic +
    # qualcommax + ramips, killing the entire 2.4GHz radio (incl. private SSID).
    # TODO: revert encryption='owe' once upstream fixes it (incident 2026-05-06,
    # ph29). Verify via test build: encryption='owe' → hostapd phy0-ap0 ENABLED
    # in logread, iwinfo phy0-ap0 shows real channel (not 0/unknown).
    if [ "$ROLE" = "bee" ]; then
        # Bee: parahub.io/free on the guest VLAN (bat0.10) — rides the mesh to a
        # bumblebee's guest network (VPN + isolation), NOT the private bridge
        uci batch <<-WIFI_2G_PUB
set wireless.public_2g=wifi-iface
set wireless.public_2g.device='${RADIO_2G}'
set wireless.public_2g.mode='ap'
set wireless.public_2g.ssid='${PUBLIC_SSID}'
set wireless.public_2g.encryption='none'
set wireless.public_2g.isolate='1'
set wireless.public_2g.network='guest'
WIFI_2G_PUB
    else
        # Bumblebee: parahub.io/free on guest network (isolated)
        uci batch <<-WIFI_2G_PUB
set wireless.public_2g=wifi-iface
set wireless.public_2g.device='${RADIO_2G}'
set wireless.public_2g.mode='ap'
set wireless.public_2g.ssid='${PUBLIC_SSID}'
set wireless.public_2g.encryption='none'
set wireless.public_2g.isolate='1'
set wireless.public_2g.network='guest'
WIFI_2G_PUB
    fi
fi

# --- 5GHz radio: mesh backhaul + Private AP ---
if [ -n "$RADIO_5G" ] && [ "$DUAL_BAND" = "true" ]; then
    # Mesh interface on 5GHz
    uci batch <<-WIFI_5G_MESH
set wireless.mesh_5g=wifi-iface
set wireless.mesh_5g.device='${RADIO_5G}'
set wireless.mesh_5g.mode='mesh'
set wireless.mesh_5g.mesh_id='${MESH_ID}'
set wireless.mesh_5g.mesh_fwding='0'
set wireless.mesh_5g.encryption='sae'
set wireless.mesh_5g.key='${MESH_KEY}'
set wireless.mesh_5g.network='bat0_hardif_mesh1'
WIFI_5G_MESH

    # Private AP on 5GHz (better throughput, 802.11r/k/v for seamless roaming)
    uci batch <<-WIFI_5G_PRIV
set wireless.private_5g=wifi-iface
set wireless.private_5g.device='${RADIO_5G}'
set wireless.private_5g.mode='ap'
set wireless.private_5g.encryption='sae-mixed'
set wireless.private_5g.network='private'
set wireless.private_5g.ieee80211r='1'
set wireless.private_5g.ft_over_ds='0'
set wireless.private_5g.ft_psk_generate_local='1'
set wireless.private_5g.mobility_domain='0a01'
set wireless.private_5g.ieee80211k='1'
set wireless.private_5g.ieee80211v='1'
WIFI_5G_PRIV

    # Private AP on 2.4GHz (range: outdoor, through walls)
    uci batch <<-WIFI_2G_PRIV
set wireless.private_2g=wifi-iface
set wireless.private_2g.device='${RADIO_2G}'
set wireless.private_2g.mode='ap'
set wireless.private_2g.encryption='sae-mixed'
set wireless.private_2g.network='private'
set wireless.private_2g.ieee80211r='1'
set wireless.private_2g.ft_over_ds='0'
set wireless.private_2g.ft_psk_generate_local='1'
set wireless.private_2g.mobility_domain='0a01'
set wireless.private_2g.ieee80211k='1'
set wireless.private_2g.ieee80211v='1'
WIFI_2G_PRIV

    # SSID/key set outside the heredoc so any character (spaces, quotes, /, &)
    # in an admin-customized value round-trips safely — heredoc interpolation
    # into single-quoted uci-batch lines would break on an embedded quote.
    uci set "wireless.private_5g.ssid=${PRIVATE_SSID}"
    uci set "wireless.private_5g.key=${PRIVATE_KEY}"
    uci set "wireless.private_2g.ssid=${PRIVATE_SSID}"
    uci set "wireless.private_2g.key=${PRIVATE_KEY}"
fi

uci commit wireless

# ============================================================================
# 6. FIREWALL CONFIGURATION
# ============================================================================

# Reset firewall to clean state
while uci -q delete firewall.@zone[0]; do :; done
while uci -q delete firewall.@forwarding[0]; do :; done
while uci -q delete firewall.@rule[0]; do :; done
while uci -q delete firewall.@redirect[0]; do :; done

if [ "$ROLE" = "bee" ]; then
    # --- Bee: minimal firewall (lan + wan only) ---
    uci batch <<-FW_EOF
# --- Zone: lan (private network) ---
add firewall zone
set firewall.@zone[-1].name='lan'
set firewall.@zone[-1].input='ACCEPT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='ACCEPT'
add_list firewall.@zone[-1].network='private'

# --- Zone: wan ---
add firewall zone
set firewall.@zone[-1].name='wan'
set firewall.@zone[-1].input='REJECT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='REJECT'
set firewall.@zone[-1].masq='1'
set firewall.@zone[-1].mtu_fix='1'
add_list firewall.@zone[-1].network='wan'

# --- Forwarding: lan → wan ---
add firewall forwarding
set firewall.@forwarding[-1].src='lan'
set firewall.@forwarding[-1].dest='wan'

# --- Standard WAN input rules ---
add firewall rule
set firewall.@rule[-1].name='Allow-DHCP-Renew'
set firewall.@rule[-1].src='wan'
set firewall.@rule[-1].proto='udp'
set firewall.@rule[-1].dest_port='68'
set firewall.@rule[-1].target='ACCEPT'
set firewall.@rule[-1].family='ipv4'

add firewall rule
set firewall.@rule[-1].name='Allow-Ping'
set firewall.@rule[-1].src='wan'
set firewall.@rule[-1].proto='icmp'
set firewall.@rule[-1].icmp_type='echo-request'
set firewall.@rule[-1].target='ACCEPT'
FW_EOF

else
    # --- Bumblebee: full firewall (3 zones + mullvad_local added by parahub-mullvad, guest kill switch) ---
    uci batch <<-FW_EOF
# --- Zone: lan (private network) ---
add firewall zone
set firewall.@zone[-1].name='lan'
set firewall.@zone[-1].input='ACCEPT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='ACCEPT'
add_list firewall.@zone[-1].network='private'

# --- Zone: guest (dual-stack — IPv6 for Yggdrasil services) ---
add firewall zone
set firewall.@zone[-1].name='guest'
set firewall.@zone[-1].input='REJECT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='REJECT'
add_list firewall.@zone[-1].network='guest'

# --- Zone: wan ---
add firewall zone
set firewall.@zone[-1].name='wan'
set firewall.@zone[-1].input='REJECT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='REJECT'
set firewall.@zone[-1].masq='1'
set firewall.@zone[-1].mtu_fix='1'
add_list firewall.@zone[-1].network='wan'

# --- Forwarding: lan → wan (internet for owner) ---
add firewall forwarding
set firewall.@forwarding[-1].src='lan'
set firewall.@forwarding[-1].dest='wan'

# --- Zone: vps_gateway (default VPN exit for guests, activated by heartbeat) ---
add firewall zone
set firewall.@zone[-1].name='vps_gateway'
set firewall.@zone[-1].input='REJECT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='REJECT'
set firewall.@zone[-1].masq='1'
set firewall.@zone[-1].mtu_fix='1'
add_list firewall.@zone[-1].network='vps_gateway'

# --- Forwarding: guest → vps_gateway (active once heartbeat enables interface) ---
add firewall forwarding
set firewall.@forwarding[-1].src='guest'
set firewall.@forwarding[-1].dest='vps_gateway'

# --- Rule: guest DHCP (allow guests to get IP) ---
add firewall rule
set firewall.@rule[-1].name='Guest DHCP'
set firewall.@rule[-1].src='guest'
set firewall.@rule[-1].proto='udp'
set firewall.@rule[-1].dest_port='67'
set firewall.@rule[-1].target='ACCEPT'
set firewall.@rule[-1].family='ipv4'

# --- Rule: guest DNS to router (hijacked to DoH, dual-stack) ---
add firewall rule
set firewall.@rule[-1].name='Guest DNS'
set firewall.@rule[-1].src='guest'
set firewall.@rule[-1].proto='tcpudp'
set firewall.@rule[-1].dest_port='53'
set firewall.@rule[-1].target='ACCEPT'

# --- Rule: block guest → lan (isolation) ---
add firewall rule
set firewall.@rule[-1].name='Block guest to LAN'
set firewall.@rule[-1].src='guest'
set firewall.@rule[-1].dest='lan'
set firewall.@rule[-1].proto='all'
set firewall.@rule[-1].target='REJECT'

# --- Rule: allow guest DHCPv6/RA (IPv6 address assignment) ---
add firewall rule
set firewall.@rule[-1].name='Guest RA'
set firewall.@rule[-1].src='guest'
set firewall.@rule[-1].proto='icmp'
set firewall.@rule[-1].family='ipv6'
set firewall.@rule[-1].icmp_type='router-solicitation'
set firewall.@rule[-1].target='ACCEPT'

# --- Rule: block guest IPv6 to WAN (only Yggdrasil allowed via forwarding) ---
add firewall rule
set firewall.@rule[-1].name='Block guest IPv6 WAN'
set firewall.@rule[-1].src='guest'
set firewall.@rule[-1].dest='wan'
set firewall.@rule[-1].proto='all'
set firewall.@rule[-1].family='ipv6'
set firewall.@rule[-1].target='REJECT'

# --- DNS hijack: redirect guest DNS to local DoH resolver ---
add firewall redirect
set firewall.@redirect[-1].name='Guest DNS hijack'
set firewall.@redirect[-1].src='guest'
set firewall.@redirect[-1].src_dport='53'
set firewall.@redirect[-1].proto='tcpudp'
set firewall.@redirect[-1].target='DNAT'
set firewall.@redirect[-1].dest='lan'
set firewall.@redirect[-1].dest_port='53'
set firewall.@redirect[-1].family='ipv4'


# --- Standard WAN input rules ---
add firewall rule
set firewall.@rule[-1].name='Allow-DHCP-Renew'
set firewall.@rule[-1].src='wan'
set firewall.@rule[-1].proto='udp'
set firewall.@rule[-1].dest_port='68'
set firewall.@rule[-1].target='ACCEPT'
set firewall.@rule[-1].family='ipv4'

add firewall rule
set firewall.@rule[-1].name='Allow-Ping'
set firewall.@rule[-1].src='wan'
set firewall.@rule[-1].proto='icmp'
set firewall.@rule[-1].icmp_type='echo-request'
set firewall.@rule[-1].target='ACCEPT'
FW_EOF

    # --- Reconcile marker-gated features clobbered by the rebuild above -------
    # Their interface config (mullvad_local WG peer, etc.) survives OTA in
    # /etc/config, but the zones/forwardings just regenerated point back at the
    # defaults. Re-apply when the markers (preserved via sysupgrade.conf) exist
    # so an OTA never silently drops a node off its own Mullvad exit / LAN-VPN.
    if [ -f /etc/parahub/mullvad_account ]; then
        uci batch <<-MULLVAD_FW
add firewall zone
set firewall.@zone[-1].name='mullvad_local'
set firewall.@zone[-1].input='REJECT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='REJECT'
set firewall.@zone[-1].masq='1'
set firewall.@zone[-1].mtu_fix='1'
add_list firewall.@zone[-1].network='mullvad_local'
MULLVAD_FW
        _fidx=0
        while uci -q get "firewall.@forwarding[$_fidx]" >/dev/null 2>&1; do
            if [ "$(uci -q get firewall.@forwarding[$_fidx].src)" = "guest" ]; then
                uci set "firewall.@forwarding[$_fidx].dest=mullvad_local"
                break
            fi
            _fidx=$((_fidx + 1))
        done
        uci -q set network.vps_gateway.auto='0'
        uci commit network

        # LAN VPN (route private clients through the VPN too) presupposes local
        # Mullvad; re-apply its policy rule, table-100 connected route and the
        # lan->mullvad_local forwarding when it was enabled.
        if [ -f /etc/parahub/lan_vpn_enabled ]; then
            uci add network rule >/dev/null
            uci set network.@rule[-1].src="${PRIV_SUBNET}/24"
            uci set network.@rule[-1].lookup='100'
            uci set network.@rule[-1].priority='99'
            uci add network route >/dev/null
            uci set network.@route[-1].interface='private'
            uci set network.@route[-1].target="${PRIV_SUBNET}/24"
            uci set network.@route[-1].table='100'
            uci commit network
            uci add firewall forwarding >/dev/null
            uci set firewall.@forwarding[-1].src='lan'
            uci set firewall.@forwarding[-1].dest='mullvad_local'
        fi
    fi
fi

uci commit firewall

# ============================================================================
# 7. DHCP CONFIGURATION
# ============================================================================

# Remove existing DHCP pools that may conflict
uci -q delete dhcp.lan 2>/dev/null || true
uci -q delete dhcp.guest 2>/dev/null || true

if [ "$ROLE" = "bee" ]; then
    # Bee: private DHCP only (no guest pool)
    uci batch <<-DHCP_EOF
set dhcp.private=dhcp
set dhcp.private.interface='private'
set dhcp.private.start='100'
set dhcp.private.limit='150'
set dhcp.private.leasetime='12h'
DHCP_EOF
else
    # Bumblebee: private + guest DHCP
    uci batch <<-DHCP_EOF
# --- Private DHCP ---
set dhcp.private=dhcp
set dhcp.private.interface='private'
set dhcp.private.start='100'
set dhcp.private.limit='150'
set dhcp.private.leasetime='12h'

# --- Guest DHCP (disabled by default: parahub-guest-gateway enables it only on
#     the one bumblebee the backend elects to terminate the guest VLAN, ph35).
#     Every bumblebee still keeps its guest IP + guest->VPN forwarding so it can
#     be promoted instantly; only the elected node actually serves leases. ---
set dhcp.guest=dhcp
set dhcp.guest.interface='guest'
set dhcp.guest.start='100'
set dhcp.guest.limit='50'
set dhcp.guest.leasetime='1h'
set dhcp.guest.ignore='1'
DHCP_EOF
fi

uci commit dhcp

# ============================================================================
# 8. SPEED CONTROL (both roles — guest shaping for Bumblebee, host cap for Bee)
# ============================================================================

chmod +x /usr/bin/parahub-speed-control

# Role-aware init.d service: reads /etc/parahub/role at runtime
cat > /etc/init.d/parahub-speed <<'INITEOF'
#!/bin/sh /etc/rc.common
START=99
start() {
    local role
    role=$(cat /etc/parahub/role 2>/dev/null || echo "bumblebee")
    if [ "$role" = "bee" ]; then
        /usr/bin/parahub-speed-control init_host
    else
        /usr/bin/parahub-speed-control init
    fi
}
stop() {
    local role
    role=$(cat /etc/parahub/role 2>/dev/null || echo "bumblebee")
    if [ "$role" = "bee" ]; then
        /usr/bin/parahub-speed-control stop_host
    else
        IFACE=$(ubus call network.interface.guest status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
        [ -n "$IFACE" ] && tc qdisc del dev "$IFACE" root 2>/dev/null
        [ -n "$IFACE" ] && tc qdisc del dev "$IFACE" ingress 2>/dev/null
        ip link del ifb-guest 2>/dev/null
        nft delete table inet parahub 2>/dev/null
    fi
}
INITEOF
chmod +x /etc/init.d/parahub-speed
/etc/init.d/parahub-speed enable

# START=99 races the batman → bat0.10 → br-guest bring-up, so the boot-time init
# bails on an empty l3_device and the free tier runs uncapped. Re-apply shaping
# from a hotplug that fires when the relevant interface actually comes up
# (guest → bumblebee init, private → bee init_host) — race-free, and re-asserts
# on any interface bounce / failover promotion.
mkdir -p /etc/hotplug.d/iface
cat > /etc/hotplug.d/iface/30-parahub-speed <<'HOTEOF'
#!/bin/sh
[ "$ACTION" = ifup ] || exit 0
role=$(cat /etc/parahub/role 2>/dev/null || echo bumblebee)
if [ "$role" = bee ]; then
    [ "$INTERFACE" = private ] || exit 0
    /usr/bin/parahub-speed-control init_host
else
    [ "$INTERFACE" = guest ] || exit 0
    /usr/bin/parahub-speed-control init
fi
HOTEOF
chmod +x /etc/hotplug.d/iface/30-parahub-speed

# Yggdrasil ACL service (Bumblebee only — blocks inbound to private by default)
if [ "$ROLE" != "bee" ]; then
    chmod +x /usr/bin/parahub-ygg-acl

    cat > /etc/init.d/parahub-ygg-acl <<'INITEOF'
#!/bin/sh /etc/rc.common
START=99
start() { /usr/bin/parahub-ygg-acl init; }
stop() { nft delete table inet parahub_ygg 2>/dev/null; }
INITEOF
    chmod +x /etc/init.d/parahub-ygg-acl
    /etc/init.d/parahub-ygg-acl enable
fi

# ============================================================================
# 9. DNS FORWARDING (Bumblebee only — VPS unbound, no DNS leak)
# ============================================================================

if [ "$ROLE" != "bee" ]; then
    # DNS resolver chain (strict-order — unbound primary, DoH strict fallback):
    #   1. 10.99.0.1   — VPS unbound via vps_gateway WG (Mullvad-routed, no DNS leak)
    #   2. 127.0.0.1#5053/5054 — DoH (cloudflare/google) via https-dns-proxy, fallback only
    # strictorder makes dnsmasq try servers in list order (10.99.0.1 first, DoH only on
    # timeout) instead of parallel-racing them. Racing leaked ~half of guest DNS to
    # Cloudflare over the raw WAN (bypassing Mullvad) and let a fast-SERVFAIL'ing unbound
    # poison results. strict-order keeps guest DNS on the VPN while unbound is up and falls
    # to DoH only when vps_gateway is down (no peer / pre-provisioning) — without DoH there
    # DNS dies entirely and the router is unusable. server='10.99.0.1' is add_list'd first
    # (above the DoH entry https-dns-proxy appends on start), so it stays the primary.
    uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null || true
    uci add_list dhcp.@dnsmasq[0].server='10.99.0.1'
    uci set dhcp.@dnsmasq[0].noresolv='1'
    uci set dhcp.@dnsmasq[0].strictorder='1'
    uci commit dhcp

    # https-dns-proxy auto-injects 127.0.0.1#5053/5054 into dnsmasq config on start.
    # NoTrack rules dir is missing on some 25.12.x targets — pre-create to avoid noise.
    mkdir -p /usr/share/nftables.d/ruleset-post
    /etc/init.d/https-dns-proxy enable 2>/dev/null || true
    /etc/init.d/https-dns-proxy start 2>/dev/null || true
fi

# Route parahub.io to Yggdrasil IPv6 (all roles: mesh traffic stays in-network)
cat >> /etc/dnsmasq.conf <<'DNSMASQ_EOF'
# parahub.io → Yggdrasil (mesh-internal, no internet needed)
address=/parahub.io/<YGG_ADDR_MAIN>
DNSMASQ_EOF

# ============================================================================
# 10. SYSTEM SETTINGS
# ============================================================================

uci batch <<-SYS_EOF
set system.@system[0].hostname='${HOSTNAME}'
set system.@system[0].timezone='UTC0'
set system.@system[0].zonename='UTC'
set system.@system[0].log_proto='udp'
set system.@system[0].conloglevel='7'
set system.@system[0].cronloglevel='9'
SYS_EOF

# NTP: use parahub-ng via Yggdrasil as primary server (available even without WAN)
uci -q delete system.ntp.server
uci add_list system.ntp.server='<YGG_ADDR_MAIN>'
uci add_list system.ntp.server='0.openwrt.pool.ntp.org'
uci add_list system.ntp.server='1.openwrt.pool.ntp.org'
uci add_list system.ntp.server='2.openwrt.pool.ntp.org'
uci set system.ntp.enabled='1'

uci commit system

# ============================================================================
# 11. YGGDRASIL OVERLAY NETWORK
# ============================================================================

# Generate unique keys for this node (skip if already exists — preserves address across OTA)
if [ ! -f /etc/yggdrasil.conf ]; then
    yggdrasil -genconf | sed 's/IfName: .*/IfName: ygg0/' > /etc/yggdrasil.conf
fi

# Bumblebee: VPS peers for direct internet connectivity
# Bee: no VPS peers — auto-discovers bumblebees via multicast on bat0/br-private
if [ "$ROLE" != "bee" ]; then
    sed -i 's|Peers: \[\]|Peers: ["tls://<NUREMBERG_VPS_IP>:443", "tls://<MADRID_VPS_IP>:443"]|' /etc/yggdrasil.conf
fi

# UCI network interface for yggdrasil TUN
uci batch <<-YGG_EOF
set network.yggdrasil=interface
set network.yggdrasil.device='ygg0'
set network.yggdrasil.proto='none'
YGG_EOF
uci commit network

# Yggdrasil firewall zone
uci batch <<-YGG_FW_EOF
add firewall zone
set firewall.@zone[-1].name='yggdrasil'
set firewall.@zone[-1].input='REJECT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='REJECT'
add_list firewall.@zone[-1].network='yggdrasil'

# Allow SSH on Yggdrasil (remote management)
add firewall rule
set firewall.@rule[-1].name='Allow SSH Ygg'
set firewall.@rule[-1].src='yggdrasil'
set firewall.@rule[-1].proto='tcp'
set firewall.@rule[-1].dest_port='22'
set firewall.@rule[-1].target='ACCEPT'

# Allow HTTP on Yggdrasil (LuCI)
add firewall rule
set firewall.@rule[-1].name='Allow HTTP Ygg'
set firewall.@rule[-1].src='yggdrasil'
set firewall.@rule[-1].proto='tcp'
set firewall.@rule[-1].dest_port='80'
set firewall.@rule[-1].target='ACCEPT'

# Allow ICMPv6 on Yggdrasil
add firewall rule
set firewall.@rule[-1].name='Allow ICMPv6 Ygg'
set firewall.@rule[-1].src='yggdrasil'
set firewall.@rule[-1].proto='icmp'
set firewall.@rule[-1].family='ipv6'
set firewall.@rule[-1].target='ACCEPT'

# Forwardings: LAN → Yggdrasil (outbound: private clients can reach Yggdrasil services)
add firewall forwarding
set firewall.@forwarding[-1].src='lan'
set firewall.@forwarding[-1].dest='yggdrasil'

# Yggdrasil → LAN forwarding (required for fw4 to accept whitelisted traffic)
# Actual filtering done by nftables parahub_ygg table (parahub-ygg-acl init)
add firewall forwarding
set firewall.@forwarding[-1].src='yggdrasil'
set firewall.@forwarding[-1].dest='lan'
YGG_FW_EOF

# Bumblebee: guest → yggdrasil forwarding via NAT66
# Guest clients access Parahub services through router's Yggdrasil address
if [ "$ROLE" != "bee" ]; then
    uci batch <<-YGG_GUEST_EOF
add firewall forwarding
set firewall.@forwarding[-1].src='guest'
set firewall.@forwarding[-1].dest='yggdrasil'
YGG_GUEST_EOF
fi
uci commit firewall

# Enable yggdrasil service
/etc/init.d/yggdrasil enable 2>/dev/null || true

# Save yggdrasil address to node keys file
YGG_ADDR=$(yggdrasil -address -useconffile /etc/yggdrasil.conf 2>/dev/null || echo "unknown")
echo "YGGDRASIL_ADDRESS=${YGG_ADDR}" >> /etc/parahub/keys

# ============================================================================
# 12. YGGDRASIL IPv6 (Bumblebee only)
#     Private: 300::/64 SLAAC — devices reachable via Yggdrasil (ACL-gated)
#     Guest: NAT66 through router's 200:: address (outbound-only)
# ============================================================================

if [ "$ROLE" != "bee" ]; then
    # Extract Yggdrasil 300::/64 subnet
    YGG_SUBNET=$(yggdrasil -subnet -useconffile /etc/yggdrasil.conf 2>/dev/null)
    # YGG_SUBNET format: 300:xxxx:xxxx:xxxx::/64
    YGG_SUBNET_PREFIX="${YGG_SUBNET%%::*}"  # 300:xxxx:xxxx:xxxx

    if [ -n "$YGG_SUBNET_PREFIX" ]; then
        # Assign 300::/64 to PRIVATE interface (not guest)
        # Private clients get globally-routable Yggdrasil addresses via SLAAC
        uci set network.private.ip6addr="${YGG_SUBNET_PREFIX}::1/64"
        uci commit network

        # Configure RA/SLAAC for private (odhcpd)
        uci batch <<-PRIV6_EOF
set dhcp.private.ra='server'
set dhcp.private.dhcpv6='disabled'
set dhcp.private.ra_management='0'
set dhcp.private.ra_default='1'
set dhcp.private.ra_slaac='1'
PRIV6_EOF
        uci commit dhcp

        # Save subnet to keys file for reference
        echo "YGGDRASIL_SUBNET=${YGG_SUBNET}" >> /etc/parahub/keys

        logger -t parahub-mesh "Private IPv6: ${YGG_SUBNET_PREFIX}::1/64 (SLAAC, ACL-gated)"
    else
        logger -t parahub-mesh "Warning: Could not extract Yggdrasil subnet"
    fi

    # NAT66 for guest: masquerade through router's Yggdrasil address
    # Guest can access Parahub services but is NOT reachable from outside
    nft add table ip6 parahub_nat66 2>/dev/null
    nft add chain ip6 parahub_nat66 postrouting '{ type nat hook postrouting priority 100; policy accept; }'
    nft add rule ip6 parahub_nat66 postrouting oifname "ygg0" masquerade

    # Guest needs a ULA address for IPv6 connectivity (source for NAT66).
    # IPv6 groups must be hex — "fd00:para:guest" was rejected by netifd as INVALID_ADDRESS.
    uci set network.guest.ip6addr="fd00:bee5::1/64"
    uci commit network

    uci batch <<-GUEST6_EOF
set dhcp.guest.ra='server'
set dhcp.guest.dhcpv6='disabled'
set dhcp.guest.ra_management='0'
set dhcp.guest.ra_default='1'
set dhcp.guest.ra_slaac='1'
GUEST6_EOF
    uci commit dhcp

    logger -t parahub-mesh "Guest IPv6: NAT66 via Yggdrasil (full speed, outbound only)"
fi

# ============================================================================
# 13. HEARTBEAT (phone-home to Parahub cloud)
# ============================================================================

chmod +x /usr/bin/parahub-heartbeat
chmod +x /usr/bin/parahub-autoupdate
chmod +x /usr/bin/parahub-gw-check
chmod +x /usr/bin/parahub-vps-setup
chmod +x /usr/bin/parahub-ygg-acl

# Cron: heartbeat every 5 min, gateway health check every 2 min, OTA nightly
# Declarative write — prevents duplicates accumulating across OTA updates
cat > /etc/crontabs/root <<'CRON_EOF'
*/5 * * * * /usr/bin/parahub-heartbeat
*/2 * * * * /usr/bin/parahub-gw-check
0 3 * * * /usr/bin/parahub-autoupdate
CRON_EOF
/etc/init.d/cron enable

